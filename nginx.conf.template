# nginx site config TEMPLATE (rendered at container start, see the Dockerfile).
#
# The nginx image's entrypoint runs envsubst over /etc/nginx/templates/*.template
# and writes /etc/nginx/conf.d/default.conf. Only the variables named in
# NGINX_ENVSUBST_FILTER (Dockerfile) are substituted, so nginx's own $variables
# below are left alone.
#
#   PORT                Listen port. Set on the Railway service; 80 in compose.
#   API_UPSTREAM        host:port of the API. docker compose: api:3001.
#                       Railway: api.railway.internal:3001 (private network).
#   NGINX_RESOLVER      Nameserver(s) for runtime DNS, derived from
#                       /etc/resolv.conf by docker/05-resolver.envsh. Needed
#                       because proxy_pass below uses a variable: the API's
#                       private address changes on every redeploy, so it has to
#                       be re-resolved per request rather than once at startup.
#   TRUST_EDGE_HEADERS  "1" when a trusted TLS-terminating edge (Railway) sits
#                       in front of this container and reports the visitor in
#                       X-Real-IP and the scheme in X-Forwarded-Proto. Leave it
#                       empty when clients reach nginx directly, or a visitor
#                       could forge those headers and dodge the API's rate limits.

# ---- what the API is told about the visitor ----
# The API keys its rate limits on X-Forwarded-For with trust proxy = 1 hop
# (this nginx). Behind Railway the socket peer is Railway's edge, so forward the
# visitor address the edge reports instead of the edge's own.
map "${TRUST_EDGE_HEADERS}" $edge_real_ip {
    "1"     $http_x_real_ip;
    default "";
}
map $edge_real_ip $forwarded_for {
    ""      $proxy_add_x_forwarded_for;
    default $edge_real_ip;
}
map $edge_real_ip $real_ip {
    ""      $remote_addr;
    default $edge_real_ip;
}
map "${TRUST_EDGE_HEADERS}" $forwarded_proto {
    "1"     $http_x_forwarded_proto;
    default $scheme;
}
# WebSocket upgrade only when the client asked for one; plain socket.io polling
# requests keep a normal connection.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Runtime DNS for the API upstream (NGINX_RESOLVER above). valid=1s so a
    # redeployed API, which gets a new private address, is picked up at once.
    resolver ${NGINX_RESOLVER} valid=1s ipv6=on;
    set $api_upstream "${API_UPSTREAM}";

    # Never advertise the server version.
    server_tokens off;

    # Reject oversized bodies at the edge; the largest legitimate POST here is a
    # job application cover letter.
    client_max_body_size 256k;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # ---- security headers ----
    # Repeated inside every location that sets its own add_header: nginx drops
    # inherited headers the moment a level declares one of its own.
    include /etc/nginx/security-headers.conf;

    # SPA fallback. index.html must never be cached or a deploy leaves clients
    # pinned to a stale asset manifest.
    location / {
        try_files $uri $uri/ /index.html;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache, must-revalidate" always;
    }

    # Long-lived caching for hashed assets and media.
    location ~* \.(js|css|woff2|jpg|jpeg|png|webp|avif|svg|ico|pdf)$ {
        expires 30d;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=2592000, immutable" always;
        try_files $uri =404;
    }

    # Block dotfiles and source maps outright.
    location ~ /\. { deny all; }
    location ~* \.map$ { deny all; }

    # API proxy. ^~ makes this prefix win over the regex locations above, so an
    # API path that happens to end in .pdf or .js is still proxied. No URI part
    # on proxy_pass: with a variable upstream nginx forwards the request URI
    # unchanged, and the API mounts /api itself.
    location ^~ /api/ {
        proxy_pass http://$api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $real_ip;
        proxy_set_header X-Forwarded-For $forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 30s;
    }

    # Live chat transport. Needs the HTTP upgrade headers or socket.io silently
    # degrades to polling and the staff console never leaves "reconnecting".
    location ^~ /socket.io/ {
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $real_ip;
        proxy_set_header X-Forwarded-For $forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 3600s;   # long-lived sockets must not be reaped
        proxy_send_timeout 3600s;
    }
}
