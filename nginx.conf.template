# nginx site config TEMPLATE (rendered at container start, see the Dockerfile).
#
# The nginx image's entrypoint runs envsubst over /etc/nginx/templates/*.template
# and writes /etc/nginx/conf.d/default.conf. Only the variables named in
# NGINX_ENVSUBST_FILTER (Dockerfile) are substituted, so nginx's own $variables
# below are left alone.
#
#   PORT                Listen port. Set on the Railway service; 80 in compose.
#   API_UPSTREAM        host:port of the API. docker compose: api:3001.
#                       Railway: api.railway.internal:3001 (private network).
#   NGINX_RESOLVER      Nameserver(s) for runtime DNS, derived from
#                       /etc/resolv.conf by docker/05-resolver.envsh. Needed
#                       because proxy_pass below uses a variable: the API's
#                       private address changes on every redeploy, so it has to
#                       be re-resolved per request rather than once at startup.
#   TRUST_EDGE_HEADERS  "1" when a trusted TLS-terminating edge (Railway) sits
#                       in front of this container and reports the visitor in
#                       X-Real-IP and the scheme in X-Forwarded-Proto. Leave it
#                       empty when clients reach nginx directly, or a visitor
#                       could forge those headers and dodge the API's rate limits.
#   CANONICAL_HOST      The one public hostname, e.g. vallepark.com. When set,
#                       any other Host (www., the railway.app URL) is answered
#                       with a 301 to it, and http is upgraded to https behind
#                       the edge. Leave empty until the custom domain is live.
#   MAINTENANCE         "1" answers every page with 503 + Retry-After (assets
#                       and the API keep working) while content is being moved.

# Map sizing must precede the first map block (nginx fixes the defaults there).
# redirects.map has long keys (old WordPress paths) that overflow the 64-byte bucket.
map_hash_bucket_size 128;
map_hash_max_size 4096;

# ---- what the API is told about the visitor ----
map "${TRUST_EDGE_HEADERS}" $edge_real_ip {
    "1"     $http_x_real_ip;
    default "";
}
map $edge_real_ip $forwarded_for {
    ""      $proxy_add_x_forwarded_for;
    default $edge_real_ip;
}
map $edge_real_ip $real_ip {
    ""      $remote_addr;
    default $edge_real_ip;
}
map "${TRUST_EDGE_HEADERS}" $forwarded_proto {
    "1"     $http_x_forwarded_proto;
    default $scheme;
}
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

# ---- canonical scheme and host ----
# Behind the edge, an http request arrives with X-Forwarded-Proto: http.
map "${TRUST_EDGE_HEADERS}:$http_x_forwarded_proto" $needs_https {
    default 0;
    "1:http" 1;
}
# "1" when CANONICAL_HOST is set AND the request's Host differs from it.
map "${CANONICAL_HOST}" $canonical_set {
    default 1;
    ""      0;
}
map "${CANONICAL_HOST}=$host" $host_differs {
    default      1;
    "~^(.+)=\1$" 0;
}
# Health probes (Railway's checker, the image HEALTHCHECK via localhost) carry no
# public hostname and must never be answered with a redirect.
map "$http_user_agent:$host" $is_probe {
    default                    0;
    "~^RailwayHealthCheck"     1;
    "~:(localhost|127\.0\.0\.1|\[::1\])$" 1;
}
map "${MAINTENANCE}" $maintenance {
    default 0;
    "1"     1;
}

# ---- 301 / 410 for the previous site's URLs (see redirects.map) ----
map $uri $legacy_target {
    include /etc/nginx/redirects.map;
    default "";
}

server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    resolver ${NGINX_RESOLVER} valid=1s ipv6=on;
    set $api_upstream "${API_UPSTREAM}";

    server_tokens off;
    client_max_body_size 256k;
    # Relative Location headers: nginx sits behind a TLS edge and does not know the
    # public scheme or port, so an absolute redirect would name http:// and 8080.
    absolute_redirect off;
    port_in_redirect off;

    gzip on;
    gzip_types text/css application/javascript application/json application/xml text/plain image/svg+xml;
    gzip_min_length 1024;

    include /etc/nginx/security-headers.conf;

    # Consistent scheme and host: one canonical origin for every URL.
    set $redirect_scheme "$needs_https$is_probe";
    if ($redirect_scheme = "10") { return 301 https://$host$request_uri; }
    set $redirect_host "$canonical_set$host_differs$is_probe";
    if ($redirect_host = "110") { return 301 https://${CANONICAL_HOST}$request_uri; }

    # Old site paths: 301 to the replacement, 410 when there is none.
    if ($legacy_target = "GONE") { return 410; }
    if ($legacy_target) { return 301 $legacy_target; }

    # Clean URLs: no trailing slash (except the root), no index.html. Matched on
    # $request_uri (what the client asked for), not $uri, so that the internal
    # redirect to /404/index.html is not itself bounced to a 301.
    if ($request_uri ~ "^/(.+)/(\?.*)?$") { return 301 /$1$2; }
    if ($request_uri ~ "^/(.*)index\.html(\?.*)?$") { return 301 /$1$2; }

    # Maintenance switch: every page 503s with a Retry-After; assets stay up.
    error_page 502 503 504 /503.html;
    location = /503.html {
        internal;
        add_header Retry-After 120 always;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/security-headers.conf;
    }

    # 404: a real status code with the prerendered not-found page as body.
    error_page 404 /404/index.html;
    location = /404/index.html {
        internal;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache, must-revalidate" always;
        add_header X-Robots-Tag "noindex" always;
    }

    # Sitemap and robots come from the API (lastmod straight from the database).
    location = /sitemap.xml {
        proxy_pass http://$api_upstream/api/sitemap.xml;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_intercept_errors on;
        error_page 502 503 504 = @sitemap_down;
    }
    location @sitemap_down { return 503; }
    location = /robots.txt {
        proxy_pass http://$api_upstream/api/robots.txt;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_intercept_errors on;
        error_page 502 503 504 = /robots-static.txt;
    }
    location = /robots-static.txt { internal; }

    # ---- public pages (prerendered where a static file exists, SPA shell otherwise) ----
    # Every location below answers 200 only for a route the app really has; anything
    # else falls through to the 404 handler, so missing pages never return 200.
    location = / {
        if ($maintenance) { return 503; }
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache, must-revalidate" always;
        try_files /index.html =404;
    }
    # Prerendered at build time: a page exists only when the build produced it, so an
    # unknown activity id or restaurant is a real 404 (add an activity -> rebuild).
    location ~ ^/(explore|packages|booking|vacancies)$ {
        if ($maintenance) { return 503; }
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache, must-revalidate" always;
        try_files $uri/index.html =404;
    }
    location ~ ^/(activities|dine)/[a-z0-9-]+$ {
        if ($maintenance) { return 503; }
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache, must-revalidate" always;
        try_files $uri/index.html =404;
    }
    # Vacancies are published from the HR back office at any time, so their pages are
    # rendered by the app from the API; an unknown slug renders the not-found page
    # (noindex) client-side.
    location ~ ^/vacancies/[a-z0-9-]+$ {
        if ($maintenance) { return 503; }
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache, must-revalidate" always;
        try_files /index.html =404;
    }
    # Back office: served by the SPA, never indexed (robots.txt is a hint, this header is not).
    location ~ ^/(staff|hr)(/.*)?$ {
        if ($maintenance) { return 503; }
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-store" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        try_files /index.html =404;
    }

    # Long-lived caching for hashed assets and media.
    location ~* \.(js|css|woff2|jpg|jpeg|png|webp|avif|svg|ico|pdf|webmanifest)$ {
        expires 30d;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=2592000, immutable" always;
        try_files $uri =404;
    }

    # Block dotfiles and source maps outright.
    location ~ /\. { deny all; }
    location ~* \.map$ { deny all; }

    # API proxy. ^~ makes this prefix win over the regex locations above.
    location ^~ /api/ {
        proxy_pass http://$api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $real_ip;
        proxy_set_header X-Forwarded-For $forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 30s;
    }

    # Live chat transport (WebSocket upgrade).
    location ^~ /socket.io/ {
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $real_ip;
        proxy_set_header X-Forwarded-For $forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Anything else: a real file (favicons, manifest, prerendered pages) or 404.
    location / {
        include /etc/nginx/security-headers.conf;
        try_files $uri =404;
    }
}
