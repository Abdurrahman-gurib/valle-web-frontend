# Base URL of the backend API. Default "/api" works with the dev-server proxy
# (vite.config.ts) and the production nginx proxy. Set an absolute URL only
# when the API is served from a different host.
VITE_API_URL=/api

# Sentry (optional): monitoring is off when unset. Build-time values, see Dockerfile.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
